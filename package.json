{
  "name": "mytwin",
  "version": "2.0.0",
  "description": "MyAITwin MCP by Luto. Personal knowledge twin, hosted multi-tenant.",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "lint:dashes": "node scripts/lint-dashes.mjs",
    "lint": "node scripts/lint-dashes.mjs",
    "test": "node --import ./scripts/reclassify/_preload-env.mjs --test tests/*.test.mjs",
    "test:xtenant": "node scripts/test-xtenant.mjs",
    "sync:inngest": "curl -fsS -X PUT https://myaitwin.lutolearn.com/api/inngest && echo ' ✓ inngest re-synced'",
    "deploy:prod": "vercel deploy --prod && npm run sync:inngest && npm run test:xtenant"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "inngest": "^3.0.0",
    "@deepgram/sdk": "^3.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "@supabase/supabase-js": "^2.43.0",
    "jose": "^5.9.6",
    "openai": "^4.47.0",
    "resend": "^4.0.0",
    "ws": "^8.20.1",
    "zod": "^3.23.0"
  }
}
