{
  "version": 2,
  "rewrites": [
    { "source": "/create",         "destination": "/create.html" },
    { "source": "/invite",         "destination": "/invite.html" },
    { "source": "/invite/:code",   "destination": "/invite.html" },
    { "source": "/privacy",        "destination": "/privacy.html" },
    { "source": "/terms",          "destination": "/terms.html" },
    { "source": "/security",       "destination": "/security.html" },
    { "source": "/docs",           "destination": "/docs.html" },
    { "source": "/twin",           "destination": "/home.html" },
    { "source": "/twin/chat",      "destination": "/twin.html" },
    { "source": "/try",            "destination": "/twin.html" },
    { "source": "/twin/profile",   "destination": "/profile.html" },
    { "source": "/twin/home-next", "destination": "/home-next.html" },
    { "source": "/twin/activation-next", "destination": "/activation-next.html" },
    { "source": "/twin/activation-v3",   "destination": "/activation-v3.html" },
    { "source": "/twin/activation",      "destination": "/activation.html" },
    { "source": "/twin/library",   "destination": "/library.html" },
    { "source": "/twin/library/concept/:id", "destination": "/concept.html" },
    { "source": "/voice",          "destination": "/voice.html" },
    { "source": "/voice/connections", "destination": "/connections.html" },
    { "source": "/connections",       "destination": "/connections.html" },
    { "source": "/p/:slug",        "destination": "/api/p/[slug]" },
    { "source": "/mcp",                                    "destination": "/api/mcp" },
    { "source": "/mcp/shared/:token",                      "destination": "/api/mcp/shared/[token]" },
    { "source": "/.well-known/oauth-protected-resource",   "destination": "/api/well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known/oauth-authorization-server" },
    { "source": "/.well-known/glama.json",                 "destination": "/api/well-known/glama.json" }
  ],
  "redirects": [
    { "source": "/dashboard.html", "destination": "/create", "permanent": true },
    { "source": "/dashboard",      "destination": "/create", "permanent": true },
    { "source": "/mcp/:userId",    "destination": "/create",  "permanent": true },
    { "source": "/admin",          "destination": "/", "permanent": true },
    { "source": "/admin.html",     "destination": "/", "permanent": true },
    { "source": "/twin/account",   "destination": "/twin/profile", "permanent": false },
    { "source": "/account",        "destination": "/twin/profile", "permanent": false },
    { "source": "/account.html",   "destination": "/twin/profile", "permanent": false }
  ],
  "functions": {
    "api/inngest.js":                       { "maxDuration": 300 },
    "api/twin/compile-concepts.js":         { "maxDuration": 300 },
    "api/admin/backfill-pinecone-types.js": { "maxDuration": 300 },
    "api/connectors/connect.js":            { "maxDuration": 300 },
    "api/connectors/sync.js":               { "maxDuration": 300 },
    "api/cron/connector-poll.js":           { "maxDuration": 300 },
    "api/twin/bulk-contribute.js":          { "maxDuration": 120 },
    "api/admin/test-cross-tenant.js":       { "maxDuration": 120 },
    "api/**/*.js":                          { "maxDuration": 60  }
  },
  "crons": [
    { "path": "/api/cron/inngest-sync",   "schedule": "0 6 * * *" },
    { "path": "/api/cron/connector-poll", "schedule": "0 7 * * *" }
  ]
}
